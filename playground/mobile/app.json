{
  "expo": {
    "name": "DS Playground",
    "slug": "ds-playground-mobile",
    "version": "0.0.1",
    "scheme": "ds-playground",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": false,
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gabrella.r.dsplaygroundmobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E53935"
      },
      "package": "com.gabrella.r.dsplaygroundmobile"
    }
  }
}
